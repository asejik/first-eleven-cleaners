# =================================================================
# FIRST ELEVEN CLEANERS — Web App Git Ignore Configuration
# =================================================================

# --- Dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Testing & Coverage ---
/coverage
.nyc_output/

# --- Next.js & Production Builds ---
/.next/
/out/
/build
/dist
.turbo/
.vercel/

# --- TypeScript ---
*.tsbuildinfo
tsconfig.tsbuildinfo

# --- Scratchpad & Temporary ---
scratch/
*TESTING_GUIDE*
*testing_guide*
TESTING_GUIDE.md

# --- Environment Files & Secrets (Strict Security) ---
.env*
!.env.example
.env.local
.env.production
.env.development
*.env
*.env.local

# --- Private Keys, Certificates & Tokens ---
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
service-account*.json
*service-role*.json
*.credentials
credentials.json
token.json

# --- Debug & Process Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- OS & Editor Metadata ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*.swn
*.bak

