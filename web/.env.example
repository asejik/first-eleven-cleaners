# ============================================
# FIRST ELEVEN CLEANERS — Environment Variables
# ============================================
# Copy this file as .env.local and fill in values.
# This is a template. See .env.local for actual values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Square ---
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# Optional server-side override; falls back to NEXT_PUBLIC_SQUARE_LOCATION_ID (src/lib/square.ts)
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+16822000039
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_NUMBER=

# --- Resend (Email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=First Eleven Cleaners <concierge@firstelevencleaners.com>

# --- Claude API (Eleven) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Upstash Redis (Distributed Rate Limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Error alerts (PR-16): where serious app errors are emailed; defaults to support@ ---
ADMIN_ALERT_EMAIL=

# --- Daily job (Vercel Cron: card holds 2 days before pickup, Payment Needed reminders) ---
# Any random text of 32+ characters; Vercel sends it to /api/cron/daily. Type Secret in Vercel.
CRON_SECRET=

# --- Search engine verification (optional, P08 SEO-10) ---
# Only needed if Search Console / Bing are verified with an HTML tag instead of DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- App Config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=First Eleven Cleaners
