# ============================================
# FIRST ELEVEN CLEANERS — Environment Variables
# ============================================
# Copy this file as .env.local and fill in values.
# This is a template. See .env.local for actual values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Square ---
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# --- Resend (Email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=First Eleven Cleaners <concierge@firstelevencleaners.com>

# --- Claude API (Eleven) ---
ANTHROPIC_API_KEY=

# --- App Config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=First Eleven Cleaners
